  ([0, 2, 5, 0, 2, 4, 0, 2, 5, 0, 2, 5, 1, 2, 5, 0, 2, 4, 1, 2, 5, 1, 3], w49)]

theorem ok : (leaves.all fun x => checkLeaf x.1 x.2) = true := by decide +kernel

theorem sem : ∀ x ∈ leaves, SemUVT (uvtBox x.1) := checkLeaves_sound leaves ok


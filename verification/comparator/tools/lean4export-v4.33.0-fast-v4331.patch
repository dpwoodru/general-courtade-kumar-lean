+partial def hashNatFull (n : Nat) (acc : UInt64 := 17) : UInt64 :=
+  if n < 18446744073709551616 then
+    mixHash acc n.toUInt64
+  else
+    hashNatFull (n >>> 64) (mixHash acc n.toUInt64)
+
+structure HashedExpr where
+  expr : Expr
+  hash : UInt64
+  deriving Inhabited
+
+@[inline] instance : BEq HashedExpr where
+  beq a b := a.expr == b.expr
+
+@[inline] instance : Hashable HashedExpr where
+  hash a := a.hash
+
+inductive PrepExpr where
+  | mk0 (he : HashedExpr)
+  | mk1 (he : HashedExpr) (c1 : PrepExpr)
+  | mk2 (he : HashedExpr) (c1 c2 : PrepExpr)
+  | mk3 (he : HashedExpr) (c1 c2 c3 : PrepExpr)
+  deriving Inhabited
+
+@[inline]
+def PrepExpr.he : PrepExpr → HashedExpr
+  | .mk0 he | .mk1 he .. | .mk2 he .. | .mk3 he .. => he
+

+partial def removeMData (e : Expr) : M PrepExpr := do
+  match e with
+  | .bvar _ | .sort _ | .const _ _ | .lit (.strVal _) => return .mk0 ⟨e, hash e⟩
+  | .fvar .. | .mvar .. => unreachable!
+  | _ =>
+    if let some x := (← get).noMDataExprs[e]? then
+      return x
+    let p ← match e with
+    | .lit (.natVal n) => pure <| .mk0 ⟨e, hashNatFull n⟩
+    | .mdata _ e' =>
+      if (← get).exportMData then
+        let pe' ← removeMData e'
+        pure <| .mk1 ⟨e.updateMData! pe'.he.expr, mixHash 43 pe'.he.hash⟩ pe'
+      else
+        removeMData e'
+    | .app f a =>
+      let pf ← removeMData f
+      let pa ← removeMData a
+      let e' := e.updateApp! pf.he.expr pa.he.expr
+      let h  := mixHash 29 (mixHash pf.he.hash pa.he.hash)
+      pure <| .mk2 ⟨e', h⟩ pf pa
+    | .lam _ d b _ =>

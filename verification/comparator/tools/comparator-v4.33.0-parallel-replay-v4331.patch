+structure EnvStats where
+  total : Nat := 0
+  digest : UInt64 := 0
+  nAxioms : Nat := 0
+  nDefns : Nat := 0
+  nThms : Nat := 0
+  nOpaques : Nat := 0
+  nQuots : Nat := 0
+  nInducts : Nat := 0
+  nCtors : Nat := 0
+  nRecs : Nat := 0
+
+def countKernelEnvConsts (env : Lean.Environment) : EnvStats :=
+  env.constants.fold (init := {}) fun st n ci =>
+    let (k, st') : UInt64 × EnvStats := match ci with
+      | .axiomInfo _  => (1, { st with nAxioms := st.nAxioms + 1 })
+      | .defnInfo _   => (2, { st with nDefns := st.nDefns + 1 })
+      | .thmInfo _    => (3, { st with nThms := st.nThms + 1 })
+      | .opaqueInfo _ => (4, { st with nOpaques := st.nOpaques + 1 })
+      | .quotInfo _   => (5, { st with nQuots := st.nQuots + 1 })
+      | .inductInfo _ => (6, { st with nInducts := st.nInducts + 1 })
+      | .ctorInfo _   => (7, { st with nCtors := st.nCtors + 1 })
+      | .recInfo _    => (8, { st with nRecs := st.nRecs + 1 })
+    { st' with
+      total := st.total + 1
+      digest := st.digest ^^^ (mixHash n.hash (mixHash k ci.type.hash)) }
 

theorem positive_kdet {a z : ℝ} (ha : a∈Icc (53/320:ℝ) (107/640))
    (hz : z∈Icc (11/20:ℝ) (361/640)) : 0 < Correction.Natural.kdet a (a+z*(1/2-a)) := by

theorem positive_m11 {a z : ℝ} (ha : a∈Icc (29/160:ℝ) (117/640))
    (hz : z∈Icc (53/80:ℝ) (433/640)) : 0 < Correction.Natural.m11 a (a+z*(1/2-a)) := by

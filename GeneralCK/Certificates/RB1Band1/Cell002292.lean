theorem positive_kdet {a z : ℝ} (ha : a∈Icc (23/400:ℝ) (3/50))
    (hz : z∈Icc (603/640:ℝ) (1)) : 0 < Correction.Natural.kdet a (a+z*(1/2-a)) := by

      nlinarith
    apply hle.trans_lt
    exact lt_of_lt_of_le (by norm_num [centerUpper,secondUpper] :
      centerUpper+secondUpper*(961/100000:ℝ)^2/24 < 2*(24/125:ℝ)/(1-(24/125:ℝ)^2)^2)

      unfold centerUpper secondUpper
      nlinarith
    apply hle.trans_lt
    exact lt_of_lt_of_le (by norm_num [centerUpper,secondUpper] :
      centerUpper+secondUpper*(441/20000:ℝ)^2/24 < 2*(11/25:ℝ)/(1-(11/25:ℝ)^2)^2)

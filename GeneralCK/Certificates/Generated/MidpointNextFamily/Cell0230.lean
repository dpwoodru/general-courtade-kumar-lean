      nlinarith
    apply hle.trans_lt
    exact lt_of_lt_of_le (by norm_num [centerUpper,secondUpper] :
      centerUpper+secondUpper*(981/100000:ℝ)^2/24 < 2*(49/250:ℝ)/(1-(49/250:ℝ)^2)^2)

      nlinarith
    apply hle.trans_lt
    exact lt_of_lt_of_le (by norm_num [centerUpper,secondUpper] :
      centerUpper+secondUpper*(409/20000:ℝ)^2/24 < 2*(51/125:ℝ)/(1-(51/125:ℝ)^2)^2)

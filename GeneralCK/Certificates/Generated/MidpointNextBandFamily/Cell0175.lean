theorem center_inputs {a z : ℝ} (ha : Bounds (877/5000) (439/2500) a)
    (hz : Bounds (406621/5000000) (17/200) z) :
    RegistersContain centerInitial (inputJets a ((biasE a+biasE (a*z))/2)) (a/2) := by

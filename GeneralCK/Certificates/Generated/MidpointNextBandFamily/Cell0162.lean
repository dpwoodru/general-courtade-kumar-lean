      unfold centerUpper secondUpper
      nlinarith
    apply hle.trans_lt
    exact lt_of_lt_of_le (by norm_num [centerUpper,secondUpper] :
      centerUpper+secondUpper*(2941/200000:ℝ)^2/24 < 2*(108/625:ℝ)/(1-(108/625:ℝ)^2)^2)

      nlinarith
    apply hle.trans_lt
    exact lt_of_lt_of_le (by norm_num [centerUpper,secondUpper] :
      centerUpper+secondUpper*(13527/1000000:ℝ)^2/24 < 2*(417/2500:ℝ)/(1-(417/2500:ℝ)^2)^2)

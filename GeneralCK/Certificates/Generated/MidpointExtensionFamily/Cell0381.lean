theorem whole_inputs {a z s : ℝ} (ha : Bounds (857/5000) (859/5000) a)
    (hz : Bounds (81/1000) (2033/25000) z) (hs : s∈Icc (a*(1-z)/2) (a*(1+z)/2)) :

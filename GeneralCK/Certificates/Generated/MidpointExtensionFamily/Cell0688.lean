      unfold centerUpper secondUpper
      nlinarith
    apply hle.trans_lt
    exact lt_of_lt_of_le (by norm_num [centerUpper,secondUpper] :
      centerUpper+secondUpper*(370431731/25000000000:ℝ)^2/24 < 2*(909/5000:ℝ)/(1-(909/5000:ℝ)^2)^2)

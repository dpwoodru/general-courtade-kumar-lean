    apply hle.trans_lt
    exact lt_of_lt_of_le (by norm_num [centerUpper,secondUpper] :
      centerUpper+secondUpper*(12605251/500000000:ℝ)^2/24 < 2*(307/1000:ℝ)/(1-(307/1000:ℝ)^2)^2)

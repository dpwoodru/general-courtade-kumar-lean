theorem whole_inputs {a z s : ℝ} (ha : Bounds (307/1000) (31/100) a)
    (hz : Bounds (2033/25000) (406621/5000000) z) (hs : s∈Icc (a*(1-z)/2) (a*(1+z)/2)) :

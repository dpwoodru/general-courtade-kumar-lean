      unfold centerUpper secondUpper
      nlinarith
    apply hle.trans_lt
    exact lt_of_lt_of_le (by norm_num [centerUpper,secondUpper] :
      centerUpper+secondUpper*(43821/2000000:ℝ)^2/24 < 2*(67/250:ℝ)/(1-(67/250:ℝ)^2)^2)

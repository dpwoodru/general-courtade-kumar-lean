      unfold centerUpper secondUpper
      nlinarith
    apply hle.trans_lt
    exact lt_of_lt_of_le (by norm_num [centerUpper,secondUpper] :
      centerUpper+secondUpper*(1648763/125000000:ℝ)^2/24 < 2*(81/500:ℝ)/(1-(81/500:ℝ)^2)^2)

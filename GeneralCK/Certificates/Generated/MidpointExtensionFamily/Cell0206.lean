      nlinarith
    apply hle.trans_lt
    exact lt_of_lt_of_le (by norm_num [centerUpper,secondUpper] :
      centerUpper+secondUpper*(5103/250000:ℝ)^2/24 < 2*(1/4:ℝ)/(1-(1/4:ℝ)^2)^2)

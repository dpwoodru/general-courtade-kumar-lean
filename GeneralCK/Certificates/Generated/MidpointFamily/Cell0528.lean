      nlinarith
    apply hle.trans_lt
    exact lt_of_lt_of_le (by norm_num [centerUpper,secondUpper] :
      centerUpper+secondUpper*(379/100000:ℝ)^2/24 < 2*(189/500:ℝ)/(1-(189/500:ℝ)^2)^2)

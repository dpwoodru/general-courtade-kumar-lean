      nlinarith
    apply hle.trans_lt
    exact lt_of_lt_of_le (by norm_num [centerUpper,secondUpper] :
      centerUpper+secondUpper*(189/100000:ℝ)^2/24 < 2*(118/625:ℝ)/(1-(118/625:ℝ)^2)^2)

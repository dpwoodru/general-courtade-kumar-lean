theorem whole_inputs_eq : wholeInitial=inputBoxes ⟨745468883632,747667906888⟩ ⟨622760053048,623682217812⟩ ⟨368996102281,377572292979⟩ := rfl
noncomputable def centerUpper : ℝ := (3082763161837 / 1099511627776)

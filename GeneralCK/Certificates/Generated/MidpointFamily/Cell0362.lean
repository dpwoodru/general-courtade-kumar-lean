      nlinarith
    apply hle.trans_lt
    exact lt_of_lt_of_le (by norm_num [centerUpper,secondUpper] :
      centerUpper+secondUpper*(513/200000:ℝ)^2/24 < 2*(32/125:ℝ)/(1-(32/125:ℝ)^2)^2)

theorem center_inputs {a z : ℝ} (ha : Bounds (903/5000) (113/625) a)
    (hz : Bounds (1/1000) (1/100) z) :
    RegistersContain centerInitial (inputJets a ((biasE a+biasE (a*z))/2)) (a/2) := by

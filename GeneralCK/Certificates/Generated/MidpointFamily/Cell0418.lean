      unfold centerUpper secondUpper
      nlinarith
    apply hle.trans_lt
    exact lt_of_lt_of_le (by norm_num [centerUpper,secondUpper] :
      centerUpper+secondUpper*(569/200000:ℝ)^2/24 < 2*(71/250:ℝ)/(1-(71/250:ℝ)^2)^2)

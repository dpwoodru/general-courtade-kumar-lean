      nlinarith
    apply hle.trans_lt
    exact lt_of_lt_of_le (by norm_num [centerUpper,secondUpper] :
      centerUpper+secondUpper*(169/100000:ℝ)^2/24 < 2*(211/1250:ℝ)/(1-(211/1250:ℝ)^2)^2)

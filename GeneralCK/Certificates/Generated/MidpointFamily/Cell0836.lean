      nlinarith
    apply hle.trans_lt
    exact lt_of_lt_of_le (by norm_num [centerUpper,secondUpper] :
      centerUpper+secondUpper*(241/25000:ℝ)^2/24 < 2*(481/500:ℝ)/(1-(481/500:ℝ)^2)^2)

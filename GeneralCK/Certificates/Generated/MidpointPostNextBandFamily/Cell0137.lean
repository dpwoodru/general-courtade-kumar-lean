theorem whole_inputs_eq : wholeInitial=inputBoxes ⟨178120883699,178230834863⟩ ⟨754815188550,754825478449⟩ ⟨81396515950,96779343331⟩ := rfl
noncomputable def centerUpper : ℝ := (11495242757 / 34359738368)

      nlinarith
    apply hle.trans_lt
    exact lt_of_lt_of_le (by norm_num [centerUpper,secondUpper] :
      centerUpper+secondUpper*(903/62500:ℝ)^2/24 < 2*(839/5000:ℝ)/(1-(839/5000:ℝ)^2)^2)

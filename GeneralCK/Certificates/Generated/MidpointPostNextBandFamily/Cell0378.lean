      nlinarith
    apply hle.trans_lt
    exact lt_of_lt_of_le (by norm_num [centerUpper,secondUpper] :
      centerUpper+secondUpper*(4257/125000:ℝ)^2/24 < 2*(389/1000:ℝ)/(1-(389/1000:ℝ)^2)^2)

      nlinarith
    apply hle.trans_lt
    exact lt_of_lt_of_le (by norm_num [centerUpper,secondUpper] :
      centerUpper+secondUpper*(36249/2500000:ℝ)^2/24 < 2*(421/2500:ℝ)/(1-(421/2500:ℝ)^2)^2)

def paths : List (List ℕ) := entries.flatMap (fun x => x.2.2.map (fun s => x.1 ++ s))

theorem leafOK : ∀ q ∈ paths, LeafOK (feBox q) := shard_sound2 entries entries_ok

end CKLaneN6.Cs.C0008

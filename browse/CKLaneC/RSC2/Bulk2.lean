import CKLaneC.RSCell.RegionI
import CKLaneC.RSC2.BA_Top
import CKLaneC.RSC2.BB_Top
import CKLaneC.RSC2.BC_Top
import CKLaneC.RSC2.BD_Top

/-! RA-stat cover: glue the family roots along b (generated by tools/emit_glue.py). -/

namespace CKLaneC.RSC2.Bulk2
open CKLaneC.RSCell

theorem root_region : RegionPos (1 / 8 : ℝ) (1 / 2 : ℝ) (0 : ℝ) (1 : ℝ) (1 / 8 : ℝ) (1 : ℝ) :=
  (RegionPos.split_b (1 / 4 : ℝ) CKLaneC.RSC2.BA_Top.root_region (RegionPos.split_b (3 / 8 : ℝ) CKLaneC.RSC2.BB_Top.root_region (RegionPos.split_b (7 / 16 : ℝ) CKLaneC.RSC2.BC_Top.root_region CKLaneC.RSC2.BD_Top.root_region)))

theorem bulk (S : ℝ) : GammaBulk S (1 / 20) (1 / 8 : ℝ) (1 / 8 : ℝ) :=
  gammaBulk_of_region (by norm_num) root_region

end CKLaneC.RSC2.Bulk2

      (Natural.entropySum (1 / 2 - t) (1 / 2 - (1 - ρ) * t)) =
      HighU.regularWeight (1 / 2 - t) (1 / 2 - (1 - ρ) * t) := (regularWeight_contact hd).symm
  simp only [F_m11, F_au, F_Jti, F_Jt, F_J, F_auNt, F_auN, F_qT, F_JJw2dR, F_JJw, F_Jw, F_tdR, F_dR, F_d, F_R, F_q, F_dJh, F_Jhm1, F_mone, F_Jh, F_h, F_mWzuzu, F_Wzuzu, F_W, F_zuzu, F_zu, F_qdq, F_dqJSi, F_Si, F_S, F_dqJ, F_dq]
  unfold Natural.m11 Natural.au Natural.zu Natural.weight
  rw [hFs, hWt]
  generalize Natural.jn (1 / 2 - t) = J at *
  generalize Natural.jn (1 / 2 - (1 - ρ) * t) = Jw at *
  generalize HighU.regularFsGap (1 / 2 - t) (1 / 2 - (1 - ρ) * t) = R at *
  generalize HighU.regularWeight (1 / 2 - t) (1 / 2 - (1 - ρ) * t) = W at *
  generalize Natural.entropySum (1 / 2 - t) (1 / 2 - (1 - ρ) * t) = S at *
  generalize Natural.qp (1 / 2 - t) = q at *
  push_cast
  field_simp
  ring

theorem G_coefS : Good (fun t ρ => HighU.actualDetGapCoefficient (1 / 2 - t) (1 / 2 - (1 - ρ) * t)) D_coef :=

  intro t ρ hd
  have ht : t ≠ 0 := hd.1.ne'
  have hJ := jn_u_ne hd
  have hJw := jn_w_ne hd
  have hS := (entropySum_pos' hd).ne'
  have hjw := jn_add_dslope hd
  simp only [F_coef, F_mInner, F_m, F_mWzz, F_Wzz, F_zz, F_z, F_qonep, F_q, F_onep, F_one, F_dJSi, F_dJ, F_d, F_J, F_Si, F_S, F_W, F_qqdU, F_qq, F_qp2, F_mdd2, F_dd2, F_qhd, F_hd_, F_h, F_dU, F_U, F_U0, F_num0t, F_num0, F_mone, F_qA1, F_A1, F_j, F_tR, F_R, F_Jti, F_Jt, F_inner, F_mJwWZZ, F_JwWZZ, F_ZZ, F_Z, F_hmd, F_md, F_msumZSi, F_sumZSi, F_sumZ, F_qpJw, F_Jw, F_qJ, F_JwW, F_tJwNVJ, F_NVJ, F_NVt, F_NV, F_num0j, F_mhmdA1J, F_hmdA1J, F_hmdA1, F_tJw, F_mJwUsUs, F_JwUsUs, F_UsUs, F_Us, F_mWzZ, F_WzZ, F_Wz]
  rw [HighU.actualDetGapCoefficient, detGap_regular _ _ _ _ _ _ _ _ _ hJ hJw hS hjw]
  generalize Natural.jn (1 / 2 - t) = J at *
  generalize Natural.jn (1 / 2 - (1 - ρ) * t) = Jw at *
  generalize dslope Natural.jn (1 / 2 - t) (1 / 2 - (1 - ρ) * t) = j at *
  generalize HighU.regularFsGap (1 / 2 - t) (1 / 2 - (1 - ρ) * t) = R at *
  generalize HighU.regularWeight (1 / 2 - t) (1 / 2 - (1 - ρ) * t) = W at *
  generalize Natural.entropySum (1 / 2 - t) (1 / 2 - (1 - ρ) * t) = S at *
  generalize Natural.qp (1 / 2 - t) = q at *
  push_cast
  field_simp
  ring

theorem m11Chain_eq : ∀ t ρ, Dom t ρ →

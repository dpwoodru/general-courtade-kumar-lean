/-- Exact physical map: the certified rational box contains the clipped physical image of the leaf. -/
theorem imageCheck_inBox {U : UVT} {B : Box} (h : imageCheck U B = true) {a b E : ℝ}
    (hin : InUVT U a b E) : InBox B a b E := by
  unfold imageCheck at h
  simp only [Bool.and_eq_true, Bool.or_eq_true, decide_eq_true_eq] at h
  obtain ⟨⟨⟨⟨⟨ht0, ht1⟩, hal⟩, hah⟩, hbl⟩, hbh⟩ := h
  obtain ⟨h1, h2, h3, h4, h5, h6, h7, h8⟩ := hin
  have hal' := pow2LowerOK_sound hal
  have hbl' := pow2UpperOK_sound hbl
  push_cast at hbl'
  refine ⟨hal'.trans h1, ?_, ?_, ?_, ?_, ?_⟩
  · rcases hah with hah | hah
    · exact h2.trans (pow2UpperOK_sound hah)
    · have hq : ((1 / 10 : ℚ) : ℝ) ≤ (B.ahi : ℝ) := Rat.cast_le.mpr hah
      have h10 : ((1 / 10 : ℚ) : ℝ) = 1 / 10 := by norm_num
      rw [h10] at hq
      linarith
  · linarith
  · rcases hbh with hbh | hbh
    · have := pow2LowerOK_sound hbh
      push_cast at this
      linarith
    · have : (1 : ℝ) - (B.alo : ℝ) ≤ (B.bhi : ℝ) := by exact_mod_cast hbh
      linarith [hal'.trans h1]
  · rw [ht0]; exact h7
  · rw [ht1]; exact h8

/-- For every fleet leaf: the physical image of the archived leaf lies in the certified rational box. -/
theorem fleet_physical_map : ∀ x ∈ allLeaves, ∀ a b E : ℝ,
    InUVT (uvtBox x.1) a b E → InBox x.2.box a b E := by
  intro x hx a b E hin
  have h := allLeaves_check x hx
  unfold checkLeaf at h
  rw [Bool.and_eq_true] at h
  exact imageCheck_inBox h.1 hin

/-- For every fleet leaf: the semantic Bellman statement on its certified rational box. -/
theorem fleet_box_sem : ∀ x ∈ allLeaves, Sem x.2.box := by
  intro x hx
  have h := allLeaves_check x hx
  unfold checkLeaf at h
  rw [Bool.and_eq_true] at h
  exact endpoint_check_sound x.2 h.2

/-- Tail-recursive Boolean list equality (avoids deep kernel recursion on 16,491 paths). -/
def pathsEqB : List (List ℕ) → List (List ℕ) → Bool
  | [], [] => true
  | x :: xs, y :: ys => decide (x = y) && pathsEqB xs ys
  | _, _ => false

theorem pathsEqB_sound : ∀ {l₁ l₂ : List (List ℕ)}, pathsEqB l₁ l₂ = true → l₁ = l₂
  | [], [], _ => rfl
  | x :: xs, y :: ys, h => by
      simp only [pathsEqB, Bool.and_eq_true, decide_eq_true_eq] at h
      rw [h.1, pathsEqB_sound h.2]
  | [], _ :: _, h => by simp [pathsEqB] at h
  | _ :: _, [], h => by simp [pathsEqB] at h

theorem paths_eqB : pathsEqB ArchTree.endpointPaths (allLeaves.map Prod.fst) = true := by
  decide +kernel

/-- The shard leaf paths are exactly the archived `endpoint_plane_taylor` leaves of the tree. -/
theorem paths_eq : ArchTree.endpointPaths = allLeaves.map Prod.fst := pathsEqB_sound paths_eqB

/-- Fleet aggregate: the psi-candidate Bellman inequality on the exact physical image of every
archived `endpoint_plane_taylor` leaf. -/
theorem fleet_endpoint_sem : ∀ p ∈ ArchTree.endpointPaths, SemUVT (uvtBox p) := by
  intro p hp
  rw [paths_eq] at hp
  obtain ⟨x, hx, rfl⟩ := List.mem_map.mp hp
  exact allLeaves_sem x hx

/-- Owner form: on every archived endpoint leaf, `μ.gap ≤ μ.cost` when psi is (weakly) active. -/
theorem fleet_endpoint_gap : ∀ p ∈ ArchTree.endpointPaths, ∀ (k : ℕ) (μ : InteriorLaw (Fin k)),
    InUVT (uvtBox p) μ.a μ.b μ.meanEntropy →
    phi μ.midpoint μ.meanEntropy ≤ psi μ.midpoint μ.meanEntropy → μ.gap ≤ μ.cost := by
  intro p hp k μ hin hact
  exact (hybrid_gap_le_psi hact).trans (fleet_endpoint_sem p hp k μ hin)

/-- Coverage-bound form over the archived partition: every law in the outer-opposite domain either
lies in the physical image of a NON-endpoint archived leaf (other owner labels), or satisfies the
psi-candidate Bellman inequality. -/
theorem fleet_domain_split (k : ℕ) (μ : InteriorLaw (Fin k))
    (ha0 : (2 : ℝ) ^ (-(28 : ℝ)) ≤ μ.a) (ha1 : μ.a ≤ 1 / 10)
    (hb0 : 1 / 2 ≤ μ.b) (hb1 : (2 : ℝ) ^ (-(28 : ℝ)) ≤ 1 - μ.b) (hab : μ.a + μ.b ≤ 1)
    (hE : (EMIN : ℝ) ≤ μ.meanEntropy) :
    (∃ q ∈ ArchTree.archTree.leaves, q.2 ≠ 0 ∧ InUVT (uvtBox q.1) μ.a μ.b μ.meanEntropy) ∨
      candidateGap psi μ.a μ.b μ.e μ.f ≤ μ.cost := by
  obtain ⟨q, hq, hin⟩ := archTree_cover μ ha0 ha1 hb0 hb1 hab hE
  by_cases hl : q.2 = 0
  · right
    have hp : q.1 ∈ ArchTree.endpointPaths := by
      unfold ArchTree.endpointPaths
      exact List.mem_map.mpr ⟨q, List.mem_filter.mpr ⟨hq, by simpa using hl⟩, rfl⟩
    exact fleet_endpoint_sem q.1 hp k μ hin
  · left
    exact ⟨q, hq, hl, hin⟩

